@model GymSystemBLL.ViewModels.CreateTrainerViewModel

@{
    ViewData["Title"] = "Create Trainer";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Add New Trainer</h3>
    </header>

    <form method="post" asp-action="Create">
        <!-- Trainer Info -->
        <div class="section-header mb-3">
            <h5 class="text-primary fw-bold">Personal Information</h5>
            <hr class="mt-2">
        </div>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Name</label>
                <input name="Name" type="text" class="form-control" asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Email</label>
                <input name="Email" type="text" class="form-control" asp-for="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Phone</label>
                <input name="Phone" type="text" class="form-control" asp-for="Phone" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">DateOfBirth</label>
                <input name="DateOfBirth" type="date" class="form-control" asp-for="DateOfBirth" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Gender</label>
                <select name="Gender" class="form-select" asp-for="Gender">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

        </div>
        <div class="section-header mb-3 mt-4">
            <h5 class="text-primary fw-bold">Address Information</h5>
            <hr class="mt-2">
        </div>
        <div class="row g-3">

            <div class="col-12 col-md-6">
                <label class="form-label">BuildingNumber</label>
                <input name="BuildingNumber" type="number" class="form-control" asp-for="BuildingNumber" />
                <span asp-validation-for="BuildingNumber" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Street</label>
                <input name="Street" type="text" class="form-control" asp-for="Street" />
                <span asp-validation-for="Street" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">City</label>
                <input name="City" type="text" class="form-control" asp-for="City" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>
        <!-- Professional Information -->
        <div class="section-header mb-3">
            <h5 class="text-primary fw-bold">Professional Information</h5>
            <hr class="mt-2">
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">
                    Specializations <span class="text-danger">*</span>
                </label>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Specialites"
                           value="GeneralFitness" asp-for="Specialites" />
                    <label class="form-check-label">GeneralFitness</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Specialites" value="Yoga" asp-for="Specialites" />
                    <label class="form-check-label">Yoga</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Specialites" value="Boxing" asp-for="Specialites" />
                    <label class="form-check-label">Boxing</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Specialites" value="CrossFit" asp-for="Specialites" />
                    <label class="form-check-label">CrossFit</label>
                </div>
                <span asp-validation-for="Specialites" class="text-danger"></span>
            </div>
        </div>

        <footer class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-fill">Add</button>
        </footer>
    </form>

</div>
